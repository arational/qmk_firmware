#include "alias.def"

// essential
COMB(CMB_TAB, KC_TAB, HOME_D, HOME_F)
COMB(CMB_ENT, KC_ENT, HOME_J, HOME_K)
COMB(CMB_ESC, KC_ESC, KC_W, KC_E)
COMB(CMB_DEL, KC_DEL, KC_I, KC_O)

// shiftable special chars which have dedicated key on a normal QUERTY keyboard
COMB(CMB_SCLN, KC_SCLN, KC_COMM, KC_DOT)
COMB(CMB_BSLS, KC_BSLS, HOME_J,  KC_SLSH)
COMB(CMB_QUOT, KC_QUOT, KC_M,    KC_COMM)
COMB(CMB_GRV,  KC_GRV,  KC_V,    KC_B)

// lower layer left hand
COMB(CMB_1,    KC_1,    KC_Q,    LL_MINS)
COMB(CMB_2,    KC_2,    KC_W,    LL_MINS)
COMB(CMB_3,    KC_3,    KC_E,    LL_MINS)
COMB(CMB_4,    KC_4,    KC_R,    LL_MINS)
COMB(CMB_5,    KC_5,    KC_T,    LL_MINS)
COMB(CMB_EXLM, KC_EXLM, HOME_A,  LL_MINS)
COMB(CMB_AT,   KC_AT,   HOME_S,  LL_MINS)
COMB(CMB_HASH, KC_HASH, HOME_D,  LL_MINS)
COMB(CMB_DLR,  KC_DLR,  HOME_F,  LL_MINS)
COMB(CMB_PERC, KC_PERC, HOME_G,  LL_MINS)
COMB(CMB_LCBR, KC_LCBR, KC_X,    LL_MINS)
COMB(CMB_LBRC, KC_LBRC, KC_C,    LL_MINS)
COMB(CMB_LPRN, KC_LPRN, KC_V,    LL_MINS)

// lower layer right hand
COMB(CMB_6,    KC_6,    KC_Y,    LL_EQL)
COMB(CMB_7,    KC_7,    KC_U,    LL_EQL)
COMB(CMB_8,    KC_8,    KC_I,    LL_EQL)
COMB(CMB_9,    KC_9,    KC_O,    LL_EQL)
COMB(CMB_0,    KC_0,    KC_P,    LL_EQL)
COMB(CMB_CIRC, KC_CIRC, HOME_H,  LL_EQL)
COMB(CMB_AMPR, KC_AMPR, HOME_J,  LL_EQL)
COMB(CMB_ASTR, KC_ASTR, HOME_K,  LL_EQL)
COMB(CMB_RPRN, KC_RPRN, KC_M,    LL_EQL)
COMB(CMB_RBRC, KC_RBRC, KC_COMM, LL_EQL)
COMB(CMB_RCBR, KC_RCBR, KC_DOT,  LL_EQL)

// dynamic macro recording
COMB(CMB_DMREC1, DM_REC1, LU_SPC, HOME_J)
COMB(CMB_DMPLY1, DM_PLY1, LU_SPC, HOME_F)
COMB(CMB_DMREC2, DM_REC2, LU_SPC, HOME_K)
COMB(CMB_DMPLY2, DM_PLY2, LU_SPC, HOME_D)

// copy-paste
COMB(CMB_CUT,  LCTL(KC_X), KC_Z, KC_X)
COMB(CMB_CPY,  LCTL(KC_C), KC_X, KC_C)
COMB(CMB_PST,  LCTL(KC_V), KC_C, KC_V)

// misc
COMB(CMB_PSCR, KC_PSCR, KC_O, KC_P)

// the effect of these combos are overwritten by inject.h
COMB(CMB_HJ_HERE, KC_NO, HOME_H, HOME_J)
COMB(CMB_J_GRVWP, KC_NO, KC_M, KC_COMM)
