#include "alias.def"

// essential
COMB(CMB_TAB, KC_TAB, HOME_D, HOME_F)
COMB(CMB_ENT, KC_ENT, HOME_J, HOME_K)
COMB(CMB_ENT2, KC_ENT, KC_4, KC_5)
COMB(CMB_ESC, KC_ESC, KC_W, KC_E)
COMB(CMB_DEL, KC_DEL, KC_I, KC_O)

// shiftable special chars which have dedicated key on a normal QUERTY keyboard
COMB(CMB_SCLN, KC_SCLN, KC_COMM, KC_DOT)
COMB(CMB_BSLS, KC_BSLS, LL_MINS, KC_SLSH)
COMB(CMB_QUOT, KC_QUOT, KC_M,    KC_COMM)
COMB(CMB_GRV,  KC_GRV,  KC_V,    KC_B)

// parenthesis
COMB(CMB_LPRN, KC_LPRN, KC_R, KC_E)
COMB(CMB_LBRC, KC_LBRC, KC_R, KC_W)
COMB(CMB_LCBR, KC_LCBR, KC_R, KC_Q)
COMB(CMB_RPRN, KC_RPRN, KC_U, KC_I)
COMB(CMB_RBRC, KC_RBRC, KC_U, KC_O)
COMB(CMB_RCBR, KC_RCBR, KC_U, KC_P)

// dynamic macro recording
COMB(CMB_DMREC1, DM_REC1, LU_SPC, HOME_J)
COMB(CMB_DMPLY1, DM_PLY1, LU_SPC, HOME_F)
COMB(CMB_DMREC2, DM_REC2, LU_SPC, HOME_K)
COMB(CMB_DMPLY2, DM_PLY2, LU_SPC, HOME_D)

// copy-paste
COMB(CMB_CUT,  LCTL(KC_X), KC_Z, KC_X)
COMB(CMB_CPY,  LCTL(KC_C), KC_X, KC_C)
COMB(CMB_PST,  LCTL(KC_V), KC_C, KC_V)
// paste from clipboard surrounded by markdown link with label "here"
SUBS(CMB_HERE, "[here](" SS_LCTL("v") ")", KC_LBRC, KC_LPRN)
// cut out marked text and paste it surrounded by grv quotes
SUBS(CMB_GRVWP, SS_LCTL("x") "`" SS_LCTL("v") "`", KC_X, KC_V)

// misc
COMB(CMB_PSCR, KC_PSCR, KC_O, KC_P)

// mod for adjust layer
COMB(CMB_ADJUSTR, LA_MO, HOME_J, LL_MINS)
COMB(CMB_ADJUSTL, LA_MO, HOME_F, LL_EQL)

// german umlauts
COMB(CMB_UUML, RALT(KC_U), KC_U, KC_E)
COMB(CMB_OUML, RALT(KC_O), KC_O, KC_E)
COMB(CMB_AUML, RALT(KC_A), HOME_A, KC_E)
