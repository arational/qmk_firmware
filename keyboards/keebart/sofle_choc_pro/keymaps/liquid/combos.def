#include "alias.def"

// essential
COMB(CMB_TAB, KC_TAB, HOME_D, HOME_F)
COMB(CMB_ENT, KC_ENT, HOME_J, HOME_K)
COMB(CMB_ESC, KC_ESC, KC_W, KC_E)
COMB(CMB_DEL, KC_DEL, KC_I, KC_O)

// shiftable special chars which have dedicated key on a normal QUERTY keyboard
COMB(CMB_SCLN, KC_SCLN, HOME_J, LL_MINS)
COMB(CMB_QUOT, KC_QUOT, KC_M, LL_MINS)
COMB(CMB_GRV,  KC_GRV, HOME_F, LL_EQL)

// parentheses
COMB(CMB_LPRN, KC_LPRN,  HOME_D, LL_MINS)
COMB(CMB_LBRC, KC_LBRC,  HOME_S, LL_MINS)
COMB(CMB_LCBR, KC_LCBR,  HOME_A, LL_MINS)
COMB(CMB_RPRN, KC_RPRN,  HOME_K, LL_EQL)
COMB(CMB_RBRC, KC_RBRC,  HOME_L, LL_EQL)
COMB(CMB_RCBR, KC_RCBR,  HOME_BS, LL_EQL)

// dynamic macro recording
COMB(CMB_DMREC1, DM_REC1, LU_SPC, HOME_J)
COMB(CMB_DMPLY1, DM_PLY1, LU_SPC, HOME_F)
COMB(CMB_DMREC2, DM_REC2, LU_SPC, HOME_K)
COMB(CMB_DMPLY2, DM_PLY2, LU_SPC, HOME_D)

// copy-paste
COMB(CMB_CUT,  LCTL(KC_X), KC_Z, KC_X)
COMB(CMB_CPY,  LCTL(KC_C), KC_X, KC_C)
COMB(CMB_PST,  LCTL(KC_V), KC_C, KC_V)

// the effect of these combos are overwritten by inject.h
COMB(CMB_HJ_HERE, KC_NO, HOME_H, HOME_J)
COMB(CMB_J_GRVWP, KC_NO, KC_M, KC_COMM)
